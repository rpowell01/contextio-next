{
  "name": "@contextio/core",
  "version": "0.3.2",
  "description": "Shared types, routing, header utilities, and SQLite database core for the @context ecosystem.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js",
      "default": "./dist/db/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/larsderidder/contextio.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/larsderidder/contextio#readme",
  "bugs": "https://github.com/larsderidder/contextio/issues",
  "keywords": [
    "llm",
    "proxy",
    "api",
    "context",
    "http",
    "sqlite",
    "database"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "cp -r src/db/migrations dist/db/migrations 2>/dev/null || true",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22",
    "tsx": "^4.23.5",
    "typescript": "^5.7"
  }
}
