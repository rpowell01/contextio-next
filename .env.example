# Required secrets (MUST be set - no defaults)
# Generate CSRF_SECRET: openssl rand -base64 32
CSRF_SECRET=

# Generate ENCRYPTION_KEY: openssl rand -base64 32
CONTEXTIO_LOGGER_ENCRYPTION_KEY=

# Optional: OIDC Configuration (uncomment to enable)
# OIDC_ENABLED=false
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPE=openid profile email
# OIDC_PUBLIC_URL=http://localhost:4040