{
  "name": "context",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:test": "turbo build && tsc -p tsconfig.test.json",
    "test": "pnpm run build:test && node --test 'dist-test/**/*.test.js'",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "dependencies": {
    "@contextio/cli": "workspace:*",
    "@contextio/core": "workspace:*",
    "@contextio/logger": "workspace:*",
    "@contextio/proxy": "workspace:*",
    "@contextio/redact": "workspace:*",
    "mime-types": "^2.1.35",
    "next": "15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22",
    "server-only": "^0.0.1",
    "tsx": "^4.23.1",
    "turbo": "^2",
    "typescript": "^5.7"
  },
  "packageManager": "pnpm@11.9.0"
}
